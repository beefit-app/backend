# ==============================================================================
# Cloudflare R2 / Storage
# ==============================================================================
ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
ACCESS_KEY_ID=your-r2-access-key-id
SECRET_ACCESS_KEY=your-r2-secret-access-key
TOKEN_VALUE=your-r2-api-token
ACCOUNT_ID=your-cloudflare-account-id

# ==============================================================================
# Segurança & Autenticação
# ==============================================================================
# Chave secreta para assinatura dos tokens JWT (mínimo de 32 caracteres)
JWT_SECRET=your-secure-jwt-secret-key-with-at-least-32-chars

# Origens permitidas pelo CORS (separadas por vírgula)
BEEFIT_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://10.0.2.2:*

# Limite máximo de tentativas de cadastro por IP/janela de tempo
BEEFIT_SECURITY_RATE_LIMIT_REGISTRATION_MAXIMUM=5

# ==============================================================================
# Negócio & Legal
# ==============================================================================
BEEFIT_BUSINESS_TIME_ZONE=America/Sao_Paulo
BEEFIT_TERMS_VERSION=2026-08-18
BEEFIT_PRIVACY_VERSION=2026-08-18
BEEFIT_REGISTRATION_ENABLED=true
BEEFIT_BETA_MODE=false
BEEFIT_BETA_ALLOWED_EMAILS=

# ==============================================================================
# Banco de Dados & Migrações (Local / Docker Compose)
# ==============================================================================
POSTGRES_DB=beefit_db
POSTGRES_USER=beefit_user
POSTGRES_PASSWORD=beefit_password
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
