spring:
  application:
    name: beefit-api

  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 11MB

  # Configurações do Hibernate / JPA
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      # Garante que o UUID seja gravado de forma legível no banco de dados
      boot:
        registry:
          selector:
            default_strategy: org.hibernate.id.uuid.UuidGenerator
      hibernate:
        format_sql: true

  # Configurações do Docker Compose do Spring
  docker:
    compose:
      lifecycle-management: start-and-stop
      readiness:
        wait: always

  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: ${SPRING_FLYWAY_BASELINE_ON_MIGRATE:false}
    baseline-version: 1

beefit:
  security:
    cors:
      allowed-origins: ""
    token:
      secret: ${JWT_SECRET}

# Lembrar de Adicionar Configurações para o Módulo de Segurança (JWT)
